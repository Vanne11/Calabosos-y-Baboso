{
  "scenes": {
    "final_heroico": {
      "scenario": {
        "name": "Final: Celebración Heroica",
        "image": "images/scenarios/final.png",
        "music": "audio/rpgchip02_bittersweet_story.ogg"
      },
      "sequence": [
        {
          "type": "dialog",
          "character": "narrator",
          "lines": [
            "Y así, contra toda estadística, lógica y buen gusto, ganaste.",
            "No te acostumbres.",
            "[dim](Finales en construcción: heroico, nuevas aventuras, retiro pacífico y el secreto.)[/dim]"
          ]
        },
        {
          "type": "choice",
          "options": [
            {
              "text": "Jugar de nuevo",
              "goto": "_restart"
            },
            {
              "text": "Salir",
              "goto": "_quit"
            }
          ]
        }
      ]
    },
    "muerte": {
      "scenario": {
        "name": "Has muerto",
        "image": "images/scenarios/muerte.png",
        "music": "audio/rpgchip15_game_over.ogg"
      },
      "sequence": [
        {
          "type": "effects",
          "effects": {
            "meta": {
              "muertes": 1
            }
          }
        },
        {
          "type": "dialog",
          "character": "narrator",
          "lines": [
            "Y así, {nombre_jugador} dejó este mundo. Nadie lloró. Bueno, el perro un poco, de risa."
          ]
        },
        {
          "type": "dialog",
          "character": "narrator",
          "lines": [],
          "pool": "muerte",
          "ai": {
            "prompt": "muerte",
            "vars": {
              "causa": "{causa_muerte}"
            }
          }
        },
        {
          "type": "notify",
          "style": "warning",
          "title": "Has muerto",
          "text": "Muertes totales: {meta.muertes}. Partidas: {meta.partidas}.",
          "icon": "💀"
        },
        {
          "type": "choice",
          "options": [
            {
              "text": "Volver al último punto seguro (el narrador no olvida)",
              "goto": "_checkpoint"
            },
            {
              "text": "Empezar de cero (masoquista)",
              "goto": "_restart"
            },
            {
              "text": "Rendirse",
              "goto": "_quit"
            }
          ]
        }
      ]
    }
  }
}
