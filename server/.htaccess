# Si subes toda la carpeta server/ dentro del webroot (Apache), esto protege lo privado.
# Lo recomendado es publicar SOLO server/public/ (ver README.md).
<FilesMatch "^(config\.php|config\.example\.php|README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm)$">
    Require all denied
</FilesMatch>
